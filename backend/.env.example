PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/medicobridge
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Email SMTP Configuration (e.g. Gmail with App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM="MedicoBridge Healthcare" <no-reply@medicobridge.com>
